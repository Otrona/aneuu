+/* The text is UTF-8: move and edit by character, not by byte. */
+
+/** \return the index of the character before the caret. */
+static int text_prev(fbtk_widget_t *widget)
+{
+	int idx = widget->u.text.idx;
+
+	if (idx <= 0)
+		return 0;
+	do {
+		idx--;
+	} while (idx > 0 && (widget->u.text.text[idx] & 0xC0) == 0x80);
+	return idx;
+}
+
+/** \return the index of the character after the caret. */
+static int text_next(fbtk_widget_t *widget)
+{
+	int idx = widget->u.text.idx;
+
+	if (idx >= widget->u.text.len)
+		return widget->u.text.len;
+	do {
+		idx++;
+	} while (idx < widget->u.text.len &&
+		 (widget->u.text.text[idx] & 0xC0) == 0x80);
+	return idx;
+}
+
+/** Delete the character before the caret. */
+static void text_delete_left(fbtk_widget_t *widget)
+{
+	int from = text_prev(widget);
+	int n = widget->u.text.idx - from;
+
+	if (n <= 0)
+		return;
+	memmove(widget->u.text.text + from,
+		widget->u.text.text + widget->u.text.idx,
+		widget->u.text.len - widget->u.text.idx);
+	widget->u.text.idx = from;
+	widget->u.text.len -= n;
+	widget->u.text.text[widget->u.text.len] = '\0';
+}
+
+/** Insert a character, as UTF-8, at the caret. \return false on failure. */
+static bool text_insert_ucs4(fbtk_widget_t *widget, uint32_t c)
+{
+	char utf8[4];
+	int n;
+	char *temp;
+
+	if (c < 0x80) {
+		utf8[0] = c;
+		n = 1;
+	} else if (c < 0x800) {
+		utf8[0] = 0xC0 | (c >> 6);
+		utf8[1] = 0x80 | (c & 0x3F);
+		n = 2;
+	} else if (c < 0x10000) {
+		utf8[0] = 0xE0 | (c >> 12);
+		utf8[1] = 0x80 | ((c >> 6) & 0x3F);
+		utf8[2] = 0x80 | (c & 0x3F);
+		n = 3;
+	} else {
+		utf8[0] = 0xF0 | (c >> 18);
+		utf8[1] = 0x80 | ((c >> 12) & 0x3F);
+		utf8[2] = 0x80 | ((c >> 6) & 0x3F);
+		utf8[3] = 0x80 | (c & 0x3F);
+		n = 4;
+	}
+
+	/* allow for the new character and the terminator */
+	temp = realloc(widget->u.text.text, widget->u.text.len + n + 1);
+	if (temp == NULL)
+		return false;
+
+	widget->u.text.text = temp;
+	memmove(widget->u.text.text + widget->u.text.idx + n,
+		widget->u.text.text + widget->u.text.idx,
+		widget->u.text.len - widget->u.text.idx);
+	memcpy(widget->u.text.text + widget->u.text.idx, utf8, n);
+	widget->u.text.idx += n;
+	widget->u.text.len += n;
+	widget->u.text.text[widget->u.text.len] = '\0';
+	return true;
+}
