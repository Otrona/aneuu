+/*
+ * Korean (Hangul) input for the NetSurf framebuffer frontend.
+ * 2-beolsik (Dubeolsik) layout. Right Alt or Shift+Space switches
+ * Korean/English.
+ *
+ * The syllable being composed is kept in the text field as ordinary text:
+ * each key press tells the caller to delete the previous character (when
+ * it was the syllable in progress) and to insert the new characters.
+ */
+
+#ifndef NETSURF_FB_HANGUL_H
+#define NETSURF_FB_HANGUL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/** What the caller must do with the text field after a key. */
+struct fb_hangul_edit {
+	int del;          /**< characters to delete to the left: 0 or 1 */
+	int n;            /**< characters to insert: 0 to 2 */
+	uint32_t ins[2];  /**< UCS4 characters to insert, in order */
+};
+
+/** Switch between Korean and English. \return true if now Korean. */
+bool fb_hangul_toggle(void);
+
+/** \return true if Korean input is on. */
+bool fb_hangul_active(void);
+
+/** Forget the syllable in progress; it stays in the field as typed. */
+void fb_hangul_reset(void);
+
+/**
+ * Feed a typed ASCII character.
+ *
+ * \param ch    the character the key would give in English
+ * \param edit  what to do with the text field
+ * \return true if the key was used for Hangul; false if the caller
+ *         should handle it as usual (the composition is then ended)
+ */
+bool fb_hangul_char(int ch, struct fb_hangul_edit *edit);
+
+/**
+ * Feed a backspace.
+ *
+ * \return true if a syllable was in progress and \a edit says what to
+ *         do; false if the caller should delete as usual
+ */
+bool fb_hangul_backspace(struct fb_hangul_edit *edit);
+
+/**
+ * Give a key press to the input method first.
+ *
+ * Handles the Korean/English switch, backspace inside a syllable and
+ * typed letters.
+ *
+ * \param keycode  libnsfb key code
+ * \param mods     fbtk modifier state (fbtk_modifier_type)
+ * \param edit     what to do with the text field when true is returned
+ * \return true if the key was consumed
+ */
+bool fb_hangul_key(int keycode, int mods, struct fb_hangul_edit *edit);
+
+/** Called when Korean/English changes, to show it to the user. */
+void fb_hangul_set_notify(void (*cb)(bool korean, void *pw), void *pw);
+
+#endif
